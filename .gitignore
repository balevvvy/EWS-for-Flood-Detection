# Virtual environment
venv/
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# Config secrets
config/config.yaml

# Data (keep directory structure)
data/raw/*
data/archive/*
!data/raw/.gitkeep
!data/archive/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Model weights (too large for GitHub, share via cloud)
*.pt
*.onnx
*.engine
*.tflite

# Large media files
*.mp4
*.avi
*.mkv

# Temporary files
tree_output.txt
*.tmp
*.db
*.sqlite3
data/*.db
